JarvisApp {
    scrollbar-visibility: hidden;
}

#dashboard {
    width: 1fr;
    height: 1fr;

    grid-size: 2 2;
    grid-columns: 2fr 3fr;
    grid-rows: 3fr 7fr;
    grid-gutter: 1;
}

#top-panel {
    column-span: 2;

}

#top-panel, 
#bottom-left,
#system-info {
    width: 1fr;
    height: 1fr;
}

#clock-date {
    width: auto;
    height: auto;
    margin: 1 0 0 3;
}

#clock {
    width: auto;
    height: auto;
}

#date {
    width: auto;
    height: auto;
    margin-left: 0;
}

#bottom-left {

}

#system-info {
    width: 1fr;
    height: 1fr;

}

#sys-info {
    align-horizontal: right;
    align-vertical: bottom;
    margin: 2 0 1 20;
}


#disk,
#memory, 
#cpu {
    margin: 0 0 0 20;
    width: 55;
    height: 1;
}

#docker-info {
    align: right middle;
    margin: 0 0 0 24;
}